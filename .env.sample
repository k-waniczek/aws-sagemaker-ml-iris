# Name of the private S3 bucket with the data (iris/train/, iris/test/, iris/output/).
# Must be in the same region as AWS_DEFAULT_REGION.
AWS_S3_BUCKET_NAME=
# ARN of the IAM execution role SageMaker uses during training,
# e.g. arn:aws:iam::<ACCOUNT_ID>:role/SageMakerIrisRole
AWS_SAGEMAKER_ROLE_ARN=
# Region where the bucket, the role quota and the training job live, e.g. eu-central-1.
AWS_DEFAULT_REGION=
# Training instance type; must have a non-zero quota in Service Quotas
# ("... for training job usage"), e.g. ml.m5.large.
AWS_SAGEMAKER_INSTANCE_TYPE=